---
import RandomScenarioButton from '../../components/RandomScenarioButton.astro';
import Sources from '../../components/Sources.astro';
import Contributors from '../../components/Contributors.astro';
import RevisionHistory from '../../components/RevisionHistory.astro';
import RevisionStamp from '../../components/RevisionStamp.astro';
import {
  advancedQuiz,
  biasNote,
  classifyQuiz,
  quiz,
  revision,
  t,
  themeLabel,
} from '../../i18n/zh-TW.ts';
import FeedbackLinks from '../../components/FeedbackLinks.astro';
import Base from '../../layouts/Base.astro';
import {
  getPublishedEntries,
  getPublishedScenarios,
  getUpdateNotes,
  type Scenario,
} from '../../lib/content.ts';
import {
  PREMISE_VERDICTS,
  SCENARIO_FORMATS,
  VALIDITY_VERDICTS,
  multiOptionIds,
} from '../../lib/content-schema.ts';
import {
  DISAGREEMENT_ENTRY,
  DISAGREEMENT_KINDS,
  NO_PROBLEM,
  buildOptions,
  soundnessOf,
  type MultiRole,
} from '../../lib/quiz.ts';
import { SECTIONS, renderMarkdown, splitSections } from '../../lib/scenario-sections.ts';
import { loadTermInfo } from '../../lib/terms-source.ts';
import { revisionsFor } from '../../lib/updates.ts';

export async function getStaticPaths() {
  const scenarios = await getPublishedScenarios();
  return scenarios.map((scenario) => ({ params: { id: scenario.id }, props: { scenario } }));
}

interface Props {
  scenario: Scenario;
}

const { scenario } = Astro.props;
const { data } = scenario;
// 內容快取可能沿用舊 schema 解析的資料（沒有 format），此時頁面會沒有任何選項；改為明確報錯。
if (!(SCENARIO_FORMATS as readonly string[]).includes(data.format)) {
  throw new Error(
    `${scenario.id}: 題型「${String(data.format)}」不明。內容快取可能過期：請停止開發伺服器，刪除 .astro/data-store.json 後重新啟動。`,
  );
}

const entries = new Map((await getPublishedEntries()).map((e) => [e.id, e]));
const titleOf = (id: string) =>
  id === NO_PROBLEM ? quiz.noProblem : (entries.get(id)?.data.title ?? id);

// 建置時的順序；前端再打亂（02 規則 2）。沒有 JavaScript 時選項不顯示，答案與解說收在「看答案與解說」。
const judgeOptions = data.format === 'judge' ? buildOptions(data.answer, data.distractors) : [];
const multiOptions =
  data.format === 'multi'
    ? (
        [
          ...data.answers.map((id) => ({ id, role: 'answer' })),
          ...data.acceptable.map((id) => ({ id, role: 'acceptable' })),
          ...data.distractors.map((id) => ({ id, role: 'distractor' })),
        ] as { id: string; role: MultiRole }[]
      ).map((o) => ({ ...o, title: titleOf(o.id), note: data.notes[o.id] ?? '' }))
    : [];
const choices = data.format === 'choice' ? data.choices : [];
const classifyItems = data.format === 'classify' ? data.items : [];
const choiceAnswer = String(choices.findIndex((c) => c.correct));
const soundness =
  data.format === 'validity-soundness' ? soundnessOf(data.validity, data.premises) : undefined;
const chooseFirst = {
  judge: quiz.chooseFirst,
  multi: advancedQuiz.multiChooseFirst,
  'validity-soundness': advancedQuiz.axesChooseFirst,
  choice: advancedQuiz.choiceChooseFirst,
  classify: classifyQuiz.chooseFirst,
}[data.format];

const terms = loadTermInfo();
const sections = splitSections(scenario.body ?? '');
const html = (key: keyof typeof SECTIONS) => {
  const md = sections.get(SECTIONS[key]);
  return md ? renderMarkdown(md, terms, `${key}-`) : '';
};
const scenarioHtml = html('scenario');
const explanationHtml = html('explanation');
const advancedHtml = html('advanced');
const perspectiveHtml = html('perspective');

const answerEntry = data.format === 'judge' ? entries.get(data.answer) : undefined;
const multiAnswers =
  data.format === 'multi' ? data.answers.flatMap((id) => entries.get(id) ?? []) : [];
const showBiasNote =
  answerEntry?.data.kind === 'bias' || multiAnswers.some((e) => e.data.kind === 'bias');
const relatedIds =
  data.format === 'judge'
    ? [data.answer, ...data.distractors]
    : data.format === 'multi'
      ? multiOptionIds(data)
      : data.format === 'classify'
        ? [DISAGREEMENT_ENTRY]
        : [];
const related = relatedIds.flatMap((id) => entries.get(id) ?? []);
// 改寫練習：judge、multi 必填；其他題型選填，沒有時不顯示（ADR-0022 §3）
const rewrite =
  data.betterPhrasing && data.checklist
    ? { betterPhrasing: data.betterPhrasing, checklist: data.checklist }
    : undefined;

// 修訂紀錄可能提到答案，收在作答後才出現的解說區塊（ADR-0025）
const revisions = revisionsFor(await getUpdateNotes(), `scenario/${scenario.id}`);

const themeScenarios = await getPublishedScenarios(data.theme);
const index = themeScenarios.findIndex((s) => s.id === scenario.id);
const later = themeScenarios.slice(index + 1);
// 下一題依模式：基礎模式跳過進階題；沒有 JavaScript 時不分模式（mode-basic-only 不顯示）
const nextAny = later[0];
const nextBasic = later.find((s) => s.data.difficulty === 'basic');
const nextLinks = (
  nextAny === nextBasic
    ? [{ target: nextAny, className: undefined }]
    : [
        { target: nextBasic, className: 'mode-basic-only' },
        { target: nextAny, className: 'mode-advanced' },
      ]
).flatMap(({ target, className }) => (target ? [{ target, className }] : []));
---

<Base title={data.title} description={`${themeLabel[data.theme]}情境題：${data.title}`} wide>
  {data.status === 'draft' && <p class="draft-banner">{t.draftNote}</p>}

  <article class="scenario" data-quiz data-scenario-id={scenario.id} data-format={data.format}>
    <header>
      <p class="meta">
        <a href={`/practice/${data.theme}/`}>{themeLabel[data.theme]}</a>
        {data.difficulty === 'advanced' && <span class="tag">{quiz.advancedOnly}</span>}
      </p>
      <h1>{data.title}</h1>
      <RevisionStamp info={revisions} linked={false} />
    </header>

    {revisions.answerChangedOn && (
      <p class="answer-changed">{revision.scenarioAnswerChanged(revisions.answerChangedOn)}</p>
    )}

    <section class="situation prose" aria-label={SECTIONS.scenario} set:html={scenarioHtml} />

    <form class="judge" data-quiz-form hidden>
      {data.format === 'judge' && (
        <fieldset>
          <legend>{quiz.question}</legend>
          <ul data-quiz-options data-quiz-group data-answer={data.answer} data-shuffle>
            {judgeOptions.map((id) => (
              <li data-option-id={id}>
                <label>
                  <input type="radio" name="choice" value={id} />
                  <span data-option-label>{titleOf(id)}</span>
                  <span class="option-tag" data-option-tag hidden />
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      )}
      {data.format === 'choice' && (
        <fieldset>
          <legend>
            <span class="task">{advancedQuiz.taskLabel[data.task]}</span>
            {data.prompt}
          </legend>
          <ul data-quiz-options data-quiz-group data-answer={choiceAnswer} data-shuffle>
            {choices.map((c, i) => (
              <li data-option-id={String(i)}>
                <label>
                  <input type="radio" name="choice" value={String(i)} />
                  <span data-option-label>{c.text}</span>
                  <span class="option-tag" data-option-tag hidden />
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      )}
      {data.format === 'classify' && (
        <fieldset aria-describedby="classify-hint">
          <legend>{data.prompt ?? classifyQuiz.question}</legend>
          <p class="hint" id="classify-hint">
            {classifyQuiz.hint}
          </p>
          <ol class="classify-items" role="list">
            {classifyItems.map((item) => (
              <li
                data-classify-item={item.id}
                data-answer={item.answer}
                data-acceptable={item.acceptable.join(' ')}
              >
                <fieldset>
                  <legend class="item-text">{item.text}</legend>
                  <ul data-quiz-options class="kinds">
                    {DISAGREEMENT_KINDS.map((kind) => (
                      <li data-option-id={kind}>
                        <label>
                          <input type="radio" name={`item-${item.id}`} value={kind} />
                          <span data-option-label>{classifyQuiz.kindLabel[kind]}</span>
                          <span class="option-tag" data-option-tag hidden />
                        </label>
                      </li>
                    ))}
                  </ul>
                </fieldset>
              </li>
            ))}
          </ol>
        </fieldset>
      )}
      {data.format === 'validity-soundness' && (
        <>
          <fieldset>
            <legend>{advancedQuiz.validityQuestion}</legend>
            <ul data-quiz-options data-quiz-group data-answer={data.validity}>
              {VALIDITY_VERDICTS.map((v) => (
                <li data-option-id={v}>
                  <label>
                    <input type="radio" name="validity" value={v} />
                    <span data-option-label>{advancedQuiz.validityLabel[v]}</span>
                    <span class="option-tag" data-option-tag hidden />
                  </label>
                </li>
              ))}
            </ul>
          </fieldset>
          <fieldset>
            <legend>{advancedQuiz.premisesQuestion}</legend>
            <ul data-quiz-options data-quiz-group data-answer={data.premises}>
              {PREMISE_VERDICTS.map((v) => (
                <li data-option-id={v}>
                  <label>
                    <input type="radio" name="premises" value={v} />
                    <span data-option-label>{advancedQuiz.premisesLabel[v]}</span>
                    <span class="option-tag" data-option-tag hidden />
                  </label>
                </li>
              ))}
            </ul>
          </fieldset>
        </>
      )}
      {data.format === 'multi' && (
        <fieldset aria-describedby="multi-hint">
          <legend>{advancedQuiz.multiQuestion}</legend>
          <p class="hint" id="multi-hint">
            {advancedQuiz.multiHint}
          </p>
          <ul data-quiz-options data-quiz-multi data-shuffle>
            {multiOptions.map((o) => (
              <li data-option-id={o.id} data-role={o.role}>
                <label>
                  <input type="checkbox" name="choice" value={o.id} />
                  <span data-option-label>{o.title}</span>
                  <span class="option-tag" data-option-tag hidden />
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      )}
      <p class="error" data-quiz-error hidden>
        {chooseFirst}
      </p>
      <button type="submit">{quiz.submit}</button>
    </form>

    <div class="result" data-quiz-result tabindex="-1" role="status" hidden>
      <span class="result-icon" data-result-icon aria-hidden="true"></span>
      <span class="result-text" data-result-text></span>
      <span class="result-choice" data-result-choice></span>
    </div>
    {/* 放在 role="status" 之外，避免連結文字被一起朗讀 */}
    <p class="result-next" data-quiz-next hidden>
      {nextLinks.map(({ target, className }) => (
        <a class={className} href={`/scenario/${target.id}/`}>
          {quiz.next}：{target.data.title}
        </a>
      ))}
      <a href={`/practice/${data.theme}/`}>{quiz.backToList}</a>
    </p>

    <details class="reveal" data-quiz-reveal>
      <summary>{quiz.reveal}</summary>
      {data.format === 'judge' && (
        <p class="answer">
          {quiz.answerIs}：
          {answerEntry ? (
            <a href={`/guide/${answerEntry.id}/`}>{answerEntry.data.title}</a>
          ) : (
            <strong>{quiz.noProblem}</strong>
          )}
        </p>
      )}
      {data.format === 'multi' && (
        <p class="answer">
          {advancedQuiz.multiAnswerIs}：
          {multiAnswers.map((e, i) => (
            <>
              {i > 0 && '、'}
              <a href={`/guide/${e.id}/`}>{e.data.title}</a>
            </>
          ))}
        </p>
      )}
      {data.format === 'choice' && (
        <p class="answer">
          {advancedQuiz.choiceAnswerIs}：<strong>{choices[Number(choiceAnswer)]?.text}</strong>
        </p>
      )}
      {data.isControl && <p class="note">{quiz.controlNote}</p>}
      {showBiasNote && <p class="note">{biasNote}</p>}
      {data.format === 'validity-soundness' && soundness && (
        <dl class="axes">
          <div>
            <dt>{advancedQuiz.axisValidity}</dt>
            <dd>
              <strong>{advancedQuiz.validityLabel[data.validity]}</strong>。{data.notes.validity}
            </dd>
          </div>
          <div>
            <dt>{advancedQuiz.axisPremises}</dt>
            <dd>
              <strong>{advancedQuiz.premisesLabel[data.premises]}</strong>。{data.notes.premises}
            </dd>
          </div>
          <div>
            <dt>{advancedQuiz.axisSoundness}</dt>
            <dd>
              <strong>{advancedQuiz.soundnessLabel[soundness]}</strong>
            </dd>
          </div>
        </dl>
      )}
      {classifyItems.length > 0 && (
        <section class="option-notes" aria-labelledby="classify-notes-title">
          <h2 id="classify-notes-title">{classifyQuiz.answerIs}</h2>
          <ol>
            {classifyItems.map((item) => (
              <li>
                <strong>{item.text}</strong>
                <span class="role">
                  （{classifyQuiz.kindLabel[item.answer]}
                  {item.acceptable.length > 0 &&
                    `；${classifyQuiz.acceptableAlso}${item.acceptable.map((k) => classifyQuiz.kindLabel[k]).join('、')}`}
                  ）
                </span>
                ：{item.note}
              </li>
            ))}
          </ol>
        </section>
      )}
      {(multiOptions.length > 0 || choices.length > 0) && (
        <section class="option-notes" aria-labelledby="option-notes-title">
          <h2 id="option-notes-title">{advancedQuiz.optionNotes}</h2>
          <ul>
            {multiOptions.map((o) => (
              <li>
                <strong>{o.title}</strong>
                <span class="role">（{advancedQuiz.roleLabel[o.role]}）</span>：{o.note}
              </li>
            ))}
            {choices.map((c) => (
              <li>
                <strong>{c.text}</strong>
                {c.correct && <span class="role">（{advancedQuiz.roleLabel.answer}）</span>}：
                {c.note}
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="prose" set:html={explanationHtml} />
      {perspectiveHtml && (
        <section class="perspective" aria-labelledby="perspective-title" data-perspective>
          <h2 id="perspective-title">{quiz.perspective}</h2>
          <p class="perspective-hint">{quiz.perspectiveHint}</p>
          <div class="prose" set:html={perspectiveHtml} />
        </section>
      )}
      {(data.form || advancedHtml) && (
        <div class="mode-advanced advanced-block">
          <h2>{quiz.advancedExplanation}</h2>
          {data.form && (
            <p class="formula">
              {quiz.form}：<span>{data.form}</span>
            </p>
          )}
          <div class="prose" set:html={advancedHtml} />
        </div>
      )}
      <Sources sources={data.sources} />
      <RevisionHistory info={revisions} />
    </details>

    {rewrite && (
      <section class="rewrite" data-quiz-rewrite aria-labelledby="rewrite-title">
        <h2 id="rewrite-title">{quiz.betterPhrasing}</h2>
        <label class="rewrite-label" for="rewrite-input">
          {quiz.rewritePrompt}
        </label>
        <textarea id="rewrite-input" rows="4" autocomplete="off" />
        <fieldset class="checklist">
          <legend>{quiz.checklistTitle}</legend>
          {rewrite.checklist.map((item) => (
            <label>
              <input type="checkbox" />
              {item}
            </label>
          ))}
        </fieldset>
        <details class="reference" data-reference>
          <summary>{quiz.showReference}</summary>
          <ul>
            {rewrite.betterPhrasing.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </details>
      </section>
    )}

    <footer class="links">
      {related.length > 0 && (
        <section aria-labelledby="related-title">
          <h2 id="related-title">{quiz.relatedEntries}</h2>
          <ul>
            {related.map((e) => (
              <li class={`kind-${e.data.kind}`}>
                <a href={`/guide/${e.id}/`}>{e.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <nav class="next" aria-label="接下來">
        {nextLinks.map(({ target, className }) => (
          <a class={className} href={`/scenario/${target.id}/`}>
            {quiz.next}：{target.data.title}
          </a>
        ))}
        <a href={`/practice/${data.theme}/`}>{quiz.backToList}</a>
        <RandomScenarioButton scenarios={await getPublishedScenarios()} exclude={scenario.id} />
      </nav>
    </footer>
    <FeedbackLinks contentId={scenario.id} kind="scenario" />
    <Contributors contributors={data.contributors} />
  </article>
</Base>

<script>
  import '../../scripts/scenario.ts';
</script>

<style>
  header {
    margin-top: 3rem;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: var(--step--1);
  }

  .meta a {
    color: var(--moss);
  }

  .tag {
    color: var(--moss);
    border: 1px solid var(--mist);
    padding: 0 0.4rem;
  }

  h1 {
    margin-top: 0.4rem;
    font-size: var(--step-3);
  }

  /* 情境：像田野筆記裡抄下的一段對話 */
  .situation {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    background: var(--paper-deep);
    border-radius: 3px;
  }

  .situation :global(blockquote) {
    border-left-color: var(--soil);
  }

  .judge {
    margin-top: 2rem;
  }

  .judge[hidden] {
    display: none;
  }

  .judge fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .judge legend {
    font-family: var(--font-hand);
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }

  .judge ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .judge label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--mist);
    border-radius: 3px;
    cursor: pointer;
  }

  .judge label:has(input:checked) {
    border-color: var(--ink);
    box-shadow: inset 3px 0 0 var(--ink);
  }

  .judge fieldset:disabled label {
    cursor: default;
  }

  .judge li.is-answer label {
    border-color: var(--moss);
    box-shadow: inset 3px 0 0 var(--moss);
  }

  .judge input {
    accent-color: var(--ink);
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
  }

  .option-tag {
    margin-left: auto;
    font-size: var(--step--1);
    color: var(--moss);
  }

  /* 進階題型（ADR-0022） */
  .judge fieldset + fieldset {
    margin-top: 1.75rem;
  }

  .task {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--moss);
  }

  .hint {
    margin: -0.25rem 0 0.75rem;
    font-size: var(--step--1);
    color: var(--moss);
  }

  .judge li.is-missed label {
    border-style: dashed;
    border-color: var(--moss);
  }

  .judge li.is-wrong label {
    border-color: var(--soil);
  }

  /* 爭點地圖（ADR-0034）：逐句一組單選。題號放在句子前（fieldset 裡的清單標記會對齊到選項列），
     選項兩欄、手機一欄，標記文字才不會被擠到換行。 */
  .judge .classify-items {
    counter-reset: statement;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .classify-items > li {
    counter-increment: statement;
  }

  .judge .classify-items legend.item-text {
    font-family: var(--font-body);
    font-size: var(--step-0);
    margin-bottom: 0.5rem;
  }

  .classify-items legend.item-text::before {
    content: counter(statement) '. ';
    color: var(--moss);
  }

  @media (min-width: 36rem) {
    .judge .kinds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .judge li.is-acceptable label {
    border-style: dashed;
    border-color: var(--moss);
  }

  .option-notes ol {
    margin: 0.5rem 0 0;
    padding-left: 1.25em;
    display: grid;
    gap: 0.4rem;
  }

  .axes {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  .axes div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 1rem;
  }

  .axes dt {
    color: var(--moss);
    font-size: var(--step--1);
    padding-top: 0.2rem;
  }

  .axes dd {
    margin: 0;
  }

  .option-notes {
    margin-top: 1.25rem;
  }

  .option-notes h2 {
    font-size: var(--step-1);
  }

  .option-notes ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25em;
    display: grid;
    gap: 0.4rem;
  }

  .role {
    color: var(--moss);
    font-size: var(--step--1);
  }

  .judge button {
    margin-top: 1rem;
    font: inherit;
    color: var(--paper);
    background: var(--ink);
    border: 0;
    border-radius: 3px;
    padding: 0.5rem 1.25rem;
    cursor: pointer;
  }

  .judge button[hidden] {
    display: none;
  }

  .error {
    margin-top: 0.75rem;
    color: var(--soil);
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--soil);
    border-radius: 3px;
  }

  .result[hidden] {
    display: none;
  }

  .result.is-correct {
    border-color: var(--moss);
  }

  .result-icon {
    font-size: var(--step-2);
    line-height: 1;
    color: var(--soil);
  }

  .result.is-correct .result-icon {
    color: var(--moss);
  }

  .result-text {
    font-family: var(--font-hand);
    font-size: var(--step-2);
  }

  .result-choice {
    width: 100%;
    color: var(--moss);
    font-size: var(--step--1);
  }

  .result-next {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
  }

  .result-next[hidden] {
    display: none;
  }

  .reveal {
