---
import HabitatIcon from '../components/HabitatIcon.astro';
import RandomScenarioButton from '../components/RandomScenarioButton.astro';
import TrackLine from '../components/TrackLine.astro';
import { themeIntro, themeLabel } from '../i18n/zh-TW.ts';
import Base from '../layouts/Base.astro';
import { getPublishedScenarios } from '../lib/content.ts';
import { THEMES } from '../lib/content-schema.ts';

const scenarios = await getPublishedScenarios();
const themes = THEMES.map((theme) => ({
  theme,
  count: scenarios.filter((s) => s.data.theme === theme).length,
}));

const steps = [
  { title: '讀情境', body: '一段虛構的對話或陳述。' },
  { title: '判讀', body: '這段推理有沒有問題？如果有，比較像哪一種？' },
  { title: '看解說', body: '為什麼有問題，以及在什麼情況下其實合理。' },
  { title: '試著改寫', body: '換一個更站得住腳的說法，再對照檢核清單看看。' },
];
---

<Base>
  <section class="hero" aria-labelledby="mission">
    <h1 id="mission">
      一步一步，
      <br />
      把話說得更好。
    </h1>
    <TrackLine />
    <p class="lead">
      讀一段日常或保育現場的對話，判斷其中的推理站不站得住腳，再試著換個說法。目標不是贏過誰，而是讓討論變得更好。
    </p>
  </section>

  <section class="themes" aria-labelledby="themes-title">
    <h2 id="themes-title">兩個主題</h2>
    <ul class="theme-list">
      {themes.map(({ theme, count }) => (
        <li class="theme">
          <HabitatIcon kind={theme} />
          <div>
            <h3>
              <a href={`/practice/${theme}/`}>{themeLabel[theme]}</a>
            </h3>
            <p>{themeIntro[theme]}</p>
            <p class="status">{count > 0 ? `${count} 題` : '題目整理中'}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="random">
      <RandomScenarioButton scenarios={scenarios} />
    </p>
  </section>

  <section class="how" aria-labelledby="how-title">
    <h2 id="how-title">一題怎麼進行</h2>
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <aside class="note" aria-labelledby="note-title">
    <h2 id="note-title">有時候，推理其實沒問題。</h2>
    <p>
      每個主題都有幾題推理本身沒有毛病。能分辨出來，和找出錯誤一樣重要：看到什麼都說是謬誤，本身也是一種謬誤。
    </p>
  </aside>
</Base>

<style>
  section,
  .note {
    margin-top: 4.5rem;
  }

  .hero {
    margin-top: clamp(3rem, 10vw, 6.5rem);
  }

  h1 {
    font-size: var(--step-4);
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  .hero :global(.tracks) {
    margin: 1.25rem 0 1.75rem;
  }

  .lead {
    font-size: var(--step-1);
    line-height: 1.8;
    max-width: 30em;
  }

  h2 {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
  }

  h3 {
    font-size: var(--step-1);
  }

  .theme-list,
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .theme-list {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 40rem) {
    .theme-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .theme {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding-left: 1rem;
    border-left: 2px solid var(--moss);
  }

  .theme p {
    margin-top: 0.25rem;
  }

  .theme h3 a {
    text-decoration: none;
  }

  .theme h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--soil);
  }

  .random {
    margin-top: 1.5rem;
  }

  .status {
    color: var(--moss);
    font-size: var(--step--1);
  }

  .steps {
    counter-reset: step;
    display: grid;
    gap: 1.25rem;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 0.75rem;
  }

  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    font-family: var(--font-hand);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--soil);
    text-align: center;
  }

  .note {
    padding: 1.5rem 1.5rem 1.75rem;
    background: var(--paper-deep);
    border-radius: 3px;
  }

  .note h2 {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }
</style>
