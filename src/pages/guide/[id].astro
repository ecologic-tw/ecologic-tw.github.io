---
import { render } from 'astro:content';
import Sources from '../../components/Sources.astro';
import Contributors from '../../components/Contributors.astro';
import { biasNote, evidenceLabel, kindLabel, t } from '../../i18n/zh-TW.ts';
import FeedbackLinks from '../../components/FeedbackLinks.astro';
import Base from '../../layouts/Base.astro';
import { getPublishedEntries, getPublishedTerms, type Entry } from '../../lib/content.ts';

export async function getStaticPaths() {
  const entries = await getPublishedEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const byId = new Map((await getPublishedEntries()).map((e) => [e.id, e]));
const termById = new Map((await getPublishedTerms()).map((term) => [term.id, term]));

const pair = data.pairWith ? byId.get(data.pairWith) : undefined;
const related = data.related.flatMap((id) => byId.get(id) ?? []);
const terms = data.terms.flatMap((id) => termById.get(id) ?? []);
---

<Base title={data.title} description={data.summary} wide>
  {data.status === 'draft' && <p class="draft-banner">{t.draftNote}</p>}

  <article class={`kind-${data.kind}`}>
    <header class="label">
      <p class="kind">
        <a href={`/guide/#kind-${data.kind}`}>{kindLabel[data.kind]}</a>
      </p>
      <h1>{data.title}</h1>
      <p class="latin en" lang="en">
        {data.en}
      </p>
      <p class="summary">{data.summary}</p>
      {data.kind === 'bias' && <p class="note">{biasNote}</p>}
      {data.evidence && (
        <p class="note evidence" data-evidence={data.evidence}>
          <strong>{evidenceLabel[data.evidence].label}</strong>：{evidenceLabel[data.evidence].note}
        </p>
      )}
      {pair && (
        <p class="note">
          容易和<a href={`/guide/${pair.id}/`}>{pair.data.title}</a>
          混淆，可以對照著看。
        </p>
      )}
      {data.form && (
        <details class="advanced form">
          <summary>形式結構</summary>
          <p class="formula">{data.form}</p>
        </details>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {data.quickCheck && (
      <section
        class="quick-check"
        data-quick-check
        data-entry-id={entry.id}
        data-answer={String(data.quickCheck.answer)}
        aria-labelledby="qc-title"
      >
        <h2 id="qc-title">小檢核</h2>
        <p class="qc-question">{data.quickCheck.question}</p>
        <form data-qc-form hidden>
          <fieldset>
            <legend class="visually-hidden">{data.quickCheck.question}</legend>
            {data.quickCheck.options.map((option, i) => (
              <label>
                <input type="radio" name="qc" value={String(i)} />
                {option}
              </label>
            ))}
          </fieldset>
          <button type="submit">送出</button>
        </form>
        <p class="qc-result" data-qc-result role="status" hidden />
        <details class="qc-reveal" data-qc-reveal>
          <summary>看答案</summary>
          <p>答案：{data.quickCheck.options[data.quickCheck.answer]}</p>
          <p>{data.quickCheck.explanation}</p>
        </details>
      </section>
    )}

    <div data-read-marker data-entry-id={entry.id} aria-hidden="true" />
    <Sources sources={data.sources} />
    <Contributors contributors={data.contributors} />

    {(related.length > 0 || terms.length > 0) && (
      <footer class="links">
        {related.length > 0 && (
          <section aria-labelledby="related-title">
            <h2 id="related-title">相關卡片</h2>
            <ul>
              {related.map((e) => (
                <li class={`kind-${e.data.kind}`}>
                  <a href={`/guide/${e.id}/`}>{e.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {terms.length > 0 && (
          <section aria-labelledby="terms-title">
            <h2 id="terms-title">用到的名詞</h2>
            <ul>
              {terms.map((term) => (
                <li>
                  <a href={`/terms/#${term.id}`}>{term.data.term}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </footer>
    )}
    <FeedbackLinks contentId={entry.id} kind="entry" />
  </article>
</Base>

<script>
  import '../../scripts/entry.ts';
</script>

<style>
  .label {
    margin-top: 3rem;
    padding-left: 1.25rem;
    border-left: 6px solid var(--kind);
  }

  .kind {
    font-size: var(--step--1);
  }

  .kind a {
    color: var(--kind);
    text-decoration: none;
  }

  .kind a:hover {
    text-decoration: underline;
  }

  h1 {
    margin-top: 0.25rem;
    font-size: var(--step-4);
    line-height: 1.2;
  }

  .en {
    margin-top: 0.35rem;
    font-size: var(--step-1);
    color: var(--moss);
  }

  .summary {
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.75;
  }

  .note {
    margin-top: 0.75rem;
    color: var(--moss);
    font-size: var(--step--1);
  }

  .note a {
    margin: 0 0.2em;
  }

  .label details.form {
    margin-top: 1.25rem;
  }

  .formula {
    font-family: var(--font-latin);
    font-size: var(--step-1);
    letter-spacing: 0.04em;
  }

  .quick-check {
    margin-top: 3rem;
    padding: 1.25rem 1.5rem 1.5rem;
    background: var(--paper-deep);
    border-radius: 3px;
  }

  .quick-check h2 {
    font-size: var(--step-1);
  }

  .qc-question {
    margin-top: 0.5rem;
  }

  .quick-check form[hidden] {
    display: none;
  }

  .quick-check fieldset {
    margin: 0.75rem 0 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.4rem;
  }

  .quick-check label {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    cursor: pointer;
  }

  .quick-check input {
    accent-color: var(--ink);
  }

  .quick-check button {
    margin-top: 0.9rem;
    font: inherit;
    color: var(--paper);
    background: var(--ink);
    border: 0;
    border-radius: 3px;
    padding: 0.35rem 1.1rem;
    cursor: pointer;
  }

  .quick-check button[hidden] {
    display: none;
  }

  .qc-result {
    margin-top: 0.75rem;
    color: var(--soil);
  }

  .qc-result.is-correct {
    color: var(--moss);
  }

  .qc-reveal {
    margin-top: 0.75rem;
  }

  .qc-reveal[hidden] {
    display: none;
  }

  .qc-reveal summary {
    cursor: pointer;
  }

  .qc-reveal p {
    margin-top: 0.5rem;
  }

  .prose {
    margin-top: 1rem;
  }

  .links {
    display: grid;
    gap: 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mist);
  }

  @media (min-width: 40rem) {
    .links {
      grid-template-columns: 1fr 1fr;
    }
  }

  .links h2 {
    font-size: var(--step-1);
  }

  .links ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .links li + li {
    margin-top: 0.3rem;
  }

  .links li[class] {
    padding-left: 0.6rem;
    border-left: 3px solid var(--kind);
  }

  /* 桌機：內文維持易讀寬度，相關連結移到右側欄 */
  @media (min-width: 64rem) {
    article {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(14rem, 20rem);
      justify-content: space-between;
      column-gap: 4rem;
    }

    article > * {
      grid-column: 1;
    }

    article > .links {
      grid-column: 2;
      grid-row: 1 / span 20;
      align-self: start;
      grid-template-columns: 1fr;
      margin-top: 3rem;
      padding: 0 0 0 1.5rem;
      border-top: 0;
      border-left: 1px solid var(--mist);
    }
  }

  /* 右側欄跟著捲動，作答後不必捲回頂端；視窗太矮時維持一般捲動，避免下半部被切掉 */
  @media (min-width: 64rem) and (min-height: 44rem) {
    article > .links {
      position: sticky;
      top: 1.5rem;
    }
  }
</style>
