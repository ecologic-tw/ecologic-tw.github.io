---
import ListFilter from '../../components/ListFilter.astro';
import { kindIntro, kindLabel, t } from '../../i18n/zh-TW.ts';
import Base from '../../layouts/Base.astro';
import { getPublishedEntries, groupByKind } from '../../lib/content.ts';

const groups = groupByKind(await getPublishedEntries());
---

<Base title="圖鑑" description="邏輯定律、有效推論、謬誤與認知偏誤的圖鑑卡。" wide>
  <h1>圖鑑</h1>
  <p class="lead">
    每張卡說明一種推理方式：它是什麼、在生活和保育討論裡長什麼樣子，以及什麼時候其實合理。
  </p>

  {groups.length === 0 ? (
    <p class="empty">圖鑑卡正在審核中，審核通過後會出現在這裡。</p>
  ) : (
    <div data-filter>
      <ListFilter id="guide-filter" />
      {groups.map(({ kind, entries }) => (
        <section class={`group kind-${kind}`} data-filter-group aria-labelledby={`kind-${kind}`}>
          <h2 id={`kind-${kind}`}>{kindLabel[kind]}</h2>
          <p class="group-intro">{kindIntro[kind]}</p>
          <ul class="entries">
            {entries.map((entry) => (
              <li
                data-filter-item
                data-filter-text={`${entry.data.title} ${entry.data.en} ${entry.data.summary}`}
              >
                <a href={`/guide/${entry.id}/`}>
                  <span class="title">{entry.data.title}</span>
                  <span class="latin">{entry.data.en}</span>
                  {entry.data.status === 'draft' && <span class="draft">{t.draftBadge}</span>}
                </a>
                <p>{entry.data.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="empty" data-filter-empty hidden>
        {t.filterEmpty}
      </p>
    </div>
  )}
</Base>

<style>
  h1 {
    margin-top: 3rem;
    font-size: var(--step-3);
  }

  .lead {
    margin-top: 0.75rem;
    max-width: 30em;
  }

  .empty {
    margin-top: 2rem;
    color: var(--moss);
  }

  .group {
    margin-top: 3rem;
  }

  .group[hidden] {
    display: none;
  }

  .group h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-2);
  }

  /* 卡別色標：像野外圖鑑書緣的分類索引 */
  .group h2::before {
    content: '';
    width: 0.5rem;
    height: 1.4em;
    background: var(--kind);
    border-radius: 1px;
  }

  .group-intro {
    margin-top: 0.25rem;
    color: var(--moss);
    font-size: var(--step--1);
  }

  .entries {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--mist);
  }

  .entries li {
    padding: 0.85rem 0 0.9rem 1rem;
    border-bottom: 1px solid var(--mist);
    border-left: 3px solid var(--kind);
  }

  .entries li[hidden] {
    display: none;
  }

  .entries a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    text-decoration: none;
  }

  .entries a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--soil);
    text-underline-offset: 0.25em;
  }

  .title {
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: 0.04em;
  }

  .entries .latin {
    color: var(--moss);
  }

  .draft {
    font-size: var(--step--1);
    color: var(--soil);
    border: 1px dashed var(--soil);
    padding: 0 0.4rem;
    line-height: 1.6;
  }

  .entries p {
    margin-top: 0.15rem;
  }

  @media (min-width: 64rem) {
    .entries {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
      column-gap: 2.5rem;
    }
  }
</style>
