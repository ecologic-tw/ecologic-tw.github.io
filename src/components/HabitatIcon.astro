</svg>

<style>
  .habitat-icon {
    width: 3rem;
    height: 3rem;
    flex: none;
    color: var(--moss);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
