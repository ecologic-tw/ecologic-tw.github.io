      <path d="M30 24.5 C35.6 23.8 37.4 27 36.2 30 C35.2 32.6 32.4 33.4 29.8 33" />
      <path d="M15 16.5 C12.8 14 16.9 12 14.8 9 C13.8 7.5 14.5 6 15.6 5" />
      <path d="M22.5 16.5 C20.3 14 24.4 12 22.3 9 C21.3 7.5 22 6 23.1 5" />
      <path d="M6 44 C16 43.2 30 43.4 40 44.2" />
    </g>
  ) : (
    <g>
      <path d="M11 45 C13.8 33 14.6 20 12.2 5.5" />
      <path d="M13.2 31 C18.5 28.4 21.6 24.2 22.4 18.6" />
      <path d="M17.5 21.5 C20.4 14.8 29.5 12.6 36.2 16.4 L42.6 14.5 L39 18.6 C39.2 25 32.4 29.4 24.6 28.2 C21.4 27.7 19 25 17.5 21.5 Z" />
