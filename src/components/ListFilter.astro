---
import { t } from '../i18n/zh-TW.ts';

interface Props {
  id: string;
}
const { id } = Astro.props;
---

<div class="list-filter" data-filter-field hidden>
  <label for={id}>{t.filterLabel}</label>
  <input id={id} type="search" placeholder={t.filterPlaceholder} autocomplete="off" />
</div>

<script>
  import '../scripts/list-filter.ts';
</script>

<style>
  .list-filter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 0.5rem;
  }

  .list-filter[hidden] {
    display: none;
  }

  label {
    color: var(--moss);
    font-size: var(--step--1);
  }

  input {
    flex: 1;
    min-width: 0;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--moss);
    padding: 0.25rem 0;
  }

  input:focus-visible {
    outline-offset: 4px;
  }
</style>
