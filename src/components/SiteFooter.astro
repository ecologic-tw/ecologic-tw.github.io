---
import { t } from '../i18n/zh-TW.ts';
---

<footer class="site-footer page">
  <p>{t.notOfficial}</p>
  <p>{t.privacy}</p>
  <p>
    {t.license}
    <a href="https://github.com/ecologic-tw" rel="noopener noreferrer">
      {t.sourceLink}
    </a>
  </p>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding-top: 1.25rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--mist);
    color: var(--moss);
    font-size: var(--step--1);
    line-height: 1.8;
  }

  .site-footer p + p {
    margin-top: 0.35rem;
  }

  .site-footer a {
    color: inherit;
  }
</style>
