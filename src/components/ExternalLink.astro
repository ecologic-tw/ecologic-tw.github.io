---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'a'> & { href: string };
const { href, ...attributes } = Astro.props;
---

<a {...attributes} href={href} target="_blank" rel="noopener noreferrer">
  <slot />
  <span class="external-note">（另開視窗）</span>
</a>

<style>
  .external-note {
    font-size: 0.8em;
    white-space: nowrap;
  }
</style>
