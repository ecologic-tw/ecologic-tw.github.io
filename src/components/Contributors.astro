---
interface Props {
  contributors?: { name: string; contribution: string }[];
}
const { contributors = [] } = Astro.props;
---

{contributors.length > 0 && (
  <aside class="contributors" aria-label="內容貢獻者">
    <h2>一起完成這份內容的人</h2>
    <ul>
      {contributors.map((person) => (
        <li>
          <strong>{person.name}</strong>：{person.contribution}
        </li>
      ))}
    </ul>
  </aside>
)}
<style>
  .contributors {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--mist);
    overflow-wrap: anywhere;
  }
  h2 {
    font-size: var(--step-0);
  }
  ul {
    padding-left: 1.25rem;
    margin-top: 0.5rem;
  }
</style>
