---
import { t } from '../i18n/zh-TW.ts';
---

<header class="site-header page">
  <a class="wordmark" href="/" aria-label={`${t.siteName} ${t.siteNameEn}，回首頁`}>
    <span class="name">{t.siteName}</span>
    <span class="latin">{t.siteNameEn}</span>
  </a>
</header>

<style>
  .site-header {
    padding-top: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--mist);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
  }

  .name {
    font-family: var(--font-hand);
    font-size: var(--step-2);
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .latin {
    color: var(--moss);
    font-size: var(--step-0);
  }
</style>
