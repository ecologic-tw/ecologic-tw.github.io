---
import { t } from '../i18n/zh-TW.ts';
import ModeSwitch from './ModeSwitch.astro';

const links = [
  { href: '/practice/daily/', label: t.nav.daily },
  { href: '/practice/conservation/', label: t.nav.conservation },
  { href: '/guide/', label: t.nav.guide },
  { href: '/terms/', label: t.nav.terms },
];
const path = Astro.url.pathname;
---

<header class="site-header page">
  <a class="wordmark" href="/" aria-label={`${t.siteName} ${t.siteNameEn}，回首頁`}>
    <span class="name">{t.siteName}</span>
    <span class="latin">{t.siteNameEn}</span>
  </a>
  <nav aria-label="主要">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <ModeSwitch />
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--mist);
  }

  .wordmark {
    margin-right: auto;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
  }

  .name {
    font-family: var(--font-hand);
    font-size: var(--step-2);
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .wordmark .latin {
    color: var(--moss);
    font-size: var(--step-0);
  }

  nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    padding-bottom: 0.15rem;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom: 2px solid var(--soil);
  }
</style>
