{
  "name": "ecologic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist.ts && node scripts/content-quality.ts",
    "preview": "astro preview",
    "check": "astro sync && astro check && node scripts/check-content.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "review": "node scripts/mark-reviewed.ts",
    "report:content": "node scripts/content-quality.ts",
    "check:links": "node scripts/check-links.ts",
    "check:docs": "node scripts/check-doc-links.ts",
    "scenario": "node scripts/scenario.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@fontsource/lxgw-wenkai-tc": "^5.3.1",
    "astro": "^7.4.1",
    "satteri": "^0.10.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
